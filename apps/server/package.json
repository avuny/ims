{
  "name": "@avuny/server",
  "version": "0.0.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "private": true,
  "author": {
    "name": "Khaled Eleskandrany",
    "email": "khaledeskandrany@gmail.com"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./schemas": "./src/schemas.ts",
    "./types": "./src/types.ts"
  },
  "scripts": {
    "test": "vitest run",
    "start": "node ./dist/index.js",
    "clean:build": "rm -rf dist && rm -rf tsconfig.build.tsbuildinfo && rm -rf .turbo && rm -rf ./openapi/openapi.json",
    "clean:modules": "rm -rf node_modules",
    "clean:all": "pnpm clean:modules && clean:build",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "api:docs": "api-documenter markdown -i temp -o docs",
    "api:extract": "api-extractor run --local",
    "openapi:generate": "tsx ./scripts/generate-openapi.ts",
    "api:generate": "orval",
    "seed": "node ./seeds/region.seed.js && tsx ./seeds/resources-permissions.seed.ts",
    "seed:resources-permissions-sidebar": "tsx ./seeds/resources-permissions-sidebar.seed.ts"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@microsoft/api-documenter": "^7.26.29",
    "@microsoft/api-extractor": "^7.52.8",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.12.4",
    "@types/qs": "^6.14.0",
    "@vitest/coverage-v8": "3.2.4",
    "@vitest/ui": "^3.2.3",
    "eslint": "^9.28.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "~5.8.3",
    "vitest": "^3.2.3",
    "zod": "^4.0.5"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@hono/structured-logger": "^0.1.0",
    "@hono/swagger-ui": "^0.5.2",
    "@hono/zod-openapi": "^1.1.5",
    "axios": "^1.13.2",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "hono": "^4.10.7",
    "i18next": "^26.3.0",
    "jsonwebtoken": "^9.0.3",
    "node-fetch": "^3.3.2",
    "orval": "^7.17.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "qs": "^6.14.1",
    "uuid": "^13.0.0",
    "@avuny/hono": "workspace:*",
    "@avuny/logger": "workspace:*",
    "@avuny/zod": "workspace:*"
  }
}
